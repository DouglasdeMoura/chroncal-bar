#!/usr/bin/env bash
# Copy at most BYTE_CAP bytes from PATH after opening it with GNU dd
# iflag=nofollow,nonblock (O_RDONLY|O_NOFOLLOW|O_NONBLOCK). Symlinks fail
# at open. FIFOs do not block; a non-regular path is refused so writer
# JSON is not emitted.
set -euo pipefail

if (( $# != 2 )); then
  printf 'usage: chroncal-read-regular PATH BYTE_CAP\n' >&2
  exit 64
fi

path=$1
cap=$2
[[ $cap =~ ^[0-9]+$ ]] || {
  printf 'BYTE_CAP must be a non-negative integer\n' >&2
  exit 64
}

tmp=$(mktemp "${TMPDIR:-/tmp}/chroncal-read-regular.XXXXXX") || exit 1
trap 'rm -f "$tmp"' EXIT

dd if="$path" of="$tmp" iflag=nofollow,nonblock count="${cap}B" status=none 2>/dev/null || exit 1
[[ $(stat -c '%F' -- "$path") == 'regular file' ]] || exit 1
cat -- "$tmp"

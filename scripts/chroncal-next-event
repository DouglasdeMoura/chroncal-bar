#!/usr/bin/env bash
# Omarchy Quattro bar plugin helper: prints one Waybar-style JSON object and exits.
# Relative labels ("in 5m", "12m left") refresh on the plugin timer.
#
# --watch keeps the old Waybar loop (emit, sleep until the next minute).
set -uo pipefail

script_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)

unavailable() {
  printf '{"text":"","class":"unavailable","tooltip":"chroncal unavailable"}\n'
}

render() {
  local agenda
  if ! agenda=$("$script_dir/chroncal-bar-agenda" --days 1); then
    unavailable
    return
  fi

  jq -c '
    def trunc($n):
      tostring as $s
      | if ($s | length) > $n then ($s[0:($n - 3)] + "...") else $s end;
    def esc:
      tostring
      | gsub("&"; "&amp;")
      | gsub("<"; "&lt;")
      | gsub(">"; "&gt;")
      | gsub("\""; "&quot;");
    def html($s): "<span>" + $s + "</span>";
    def hm: fromdateiso8601 | strflocaltime("%H:%M");
    def color_block($event):
      "<font color=\"\($event.calendar_color // "#888888")\">■</font>";
    def event_line($event):
      if $event.all_day then
        "\(color_block($event))  All day · \($event.title | esc)"
      else
        "\(color_block($event))  \($event.start_time | hm)-\($event.end_time | hm) · \($event.title | esc)"
      end;
    def duration_label($seconds):
      ((($seconds + 59) / 60) | floor) as $mins
      | if $mins >= 60 then
          (($mins / 60 | floor) as $hours
            | ($mins % 60) as $rem
            | if $rem == 0 then "\($hours)h" else "\($hours)h \($rem)m" end)
        else
          "\($mins)m"
        end;
    def event_label_time($start; $end; $start_time; $now):
      if $start > $now then
        if ($start - $now) <= 600 then "in \(duration_label($start - $now))" else ($start_time | hm) end
      elif ($now - $start) < 60 then
        "Now"
      else
        "\(duration_label($end - $now)) left"
      end;

    if .status != "ok" then
      {text: "", class: "unavailable", tooltip: "chroncal unavailable"}
    else
      (.generated_at | fromdateiso8601) as $now
      | .events as $events
      | ($events
          | if length == 0 then "No events today" else (map(event_line(.)) | join("<br>")) end) as $tooltip
      | ($events[0] // null) as $event
      | if $event == null then
          {text: "", class: "empty", tooltip: html($tooltip)}
        elif $event.all_day then
          {
            text: html(" All day · " + ($event.title | trunc(42) | esc) + " "),
            class: "all-day",
            tooltip: html($tooltip)
          }
        else
          $event as $anchor
          | ($anchor.start_time | fromdateiso8601) as $astart
          | ($anchor.end_time | fromdateiso8601) as $aend
          | (if $astart <= $now and $aend > $now then "in-progress" else "upcoming" end) as $base_class
          | event_label_time($astart; $aend; $anchor.start_time; $now) as $lead
          | ([$events[]
               | select((.all_day | not)
                   and ((.start_time | fromdateiso8601) < $aend)
                   and ($astart < (.end_time | fromdateiso8601)))]) as $cluster
          | if ($cluster | length) <= 1 then
              {
                text: html(" " + ($lead + " · " + ($anchor.title | trunc(42) | esc)) + " "),
                class: $base_class,
                tooltip: html($tooltip)
              }
            else
              ($cluster | length) as $n
              | ($cluster[0:3]
                  | map(
                      (.start_time | fromdateiso8601) as $start
                      | (.end_time | fromdateiso8601) as $end
                      | color_block(.) + " " + event_label_time($start; $end; .start_time; $now) + " · " + (.title | trunc(18) | esc))
                  | join(" | ")) as $body
              | (if $n > 3 then " +\($n - 3)" else "" end) as $more
              | {
                  text: html(" " + $body + $more + " "),
                  class: [$base_class, "overlap"],
                  tooltip: html($tooltip)
                }
            end
        end
    end
  ' <<<"$agenda" || unavailable
}

if [[ "${1:-}" == "--watch" ]]; then
  while true; do
    render
    sleep "$((60 - 10#$(date +%S)))"
  done
else
  render
fi

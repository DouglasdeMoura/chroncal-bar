#!/usr/bin/env bash
set -uo pipefail

events_cap=$((8 * 1024 * 1024))
calendars_cap=$((256 * 1024))
state_cap=$((1024 * 1024))

unavailable() {
  notify-send -u low "chroncal" "${1:-chroncal unavailable}" 2>/dev/null || :
  exit 0
}

script_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
work_dir=$(mktemp -d "${TMPDIR:-/tmp}/chroncal-open-url.XXXXXX") || unavailable
trap 'rm -rf "$work_dir"' EXIT

today=$(date +%F)
now=$(date +%s)
state_dir=${XDG_STATE_HOME:-$HOME/.local/state}
state_file="$state_dir/chroncal/state.json"

# Producer-side byte ceilings: a large or compromised backend response is
# never buffered whole into this shell.
if ! timeout 10 chroncal event list --from "$today" --to "$today" --output json 2>/dev/null \
  | head -c "$events_cap" > "$work_dir/events.json"; then
  unavailable
fi

if ! timeout 10 chroncal calendar list --output json 2>/dev/null \
  | head -c "$calendars_cap" > "$work_dir/calendars.json"; then
  printf '[]\n' > "$work_dir/calendars.json"
fi

printf '[]\n' > "$work_dir/hidden.json"
# GNU dd opens with O_NOFOLLOW|O_NONBLOCK, then we refuse a non-regular
# path: a FIFO or symlink replacement cannot block or redirect the read.
if "$script_dir/chroncal-read-regular" "$state_file" "$state_cap" \
    >"$work_dir/state.json" 2>/dev/null; then
  jq -c '.hidden_calendars // []' "$work_dir/state.json" > "$work_dir/hidden.json" 2>/dev/null \
    || printf '[]\n' > "$work_dir/hidden.json"
fi

url=$(jq -r --argjson now "$now" \
  --slurpfile calendars "$work_dir/calendars.json" \
  --slurpfile hidden_calendar_ids "$work_dir/hidden.json" '
  ($calendars[0] // []) as $calendars
  | ($hidden_calendar_ids[0] // []) as $hidden_calendar_ids
  | def is_visible($event):
      ($hidden_calendar_ids | index($event.calendar_id)) == null;
  def first_url($s):
    (($s // "") | match("https?://[^[:space:]<>\"]+")?.string // "");
  def calendar_owner_email($id):
    ((($calendars[]? | select(.id == $id) | .owner_email) // "") | select(. != "")) // "";
  def google_authuser_host($host):
    ($host == "meet.google.com") or ($host == "calendar.google.com") or ($host | test("(^|\\.)docs\\.google\\.com$"));
  def with_google_authuser($url; $email):
    if $email == "" then $url
    elif ($url | test("[?&]authuser=")) then $url
    elif ($url | test("^https?://[^/:?#]+")) then
      ($url | capture("^https?://(?<host>[^/:?#]+)").host) as $host
      | if google_authuser_host($host) then
          $url + (if ($url | contains("?")) then "&" else "?" end) + "authuser=" + ($email | @uri)
        else $url
        end
    else $url
    end;
  def event_url($event):
    ($event.conference_uri // "") as $conference_url
    | ($event.url // "") as $url
    | first_url($event.location) as $location_url
    | first_url($event.description) as $description_url
    | calendar_owner_email($event.calendar_id) as $owner_email
    | if $conference_url != "" then $conference_url
      elif $url != "" then $url
      elif $location_url != "" then $location_url
      else $description_url
      end
    | with_google_authuser(.; $owner_email);

  [.[] | select(is_visible(.)) | select((.end_time | fromdateiso8601) > $now)]
  | sort_by(.start_time | fromdateiso8601)
  | .[0] as $event
  | if $event == null then "" else event_url($event) end
' <"$work_dir/events.json")

if [[ -z "$url" || "$url" == "null" ]]; then
  notify-send -u low "chroncal" "No link for the next event"
  exit 0
fi

if [[ ! $url =~ ^https?:// ]]; then
  notify-send -u low "chroncal" "Refused non-web link for the next event"
  exit 0
fi

xdg-open "$url" >/dev/null 2>&1 &

{
  "schemaVersion": 1,
  "id": "douglasdemoura.chroncal-bar",
  "name": "Chroncal Bar",
  "version": "1.1.4",
  "author": "Douglas Moura",
  "license": "MIT",
  "description": "Chroncal menu-bar agenda, search, quick actions, and event editing for Omarchy Quattro.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Chroncal Bar",
    "description": "Chroncal agenda, search, quick actions, and event editing",
    "category": "Time",
    "allowMultiple": false,
    "defaultSection": "right",
    "schema": [
      {
        "key": "interval",
        "type": "integer",
        "label": "Refresh interval (seconds)",
        "min": 15,
        "max": 3600,
        "step": 15,
        "defaultValue": 60
      },
      {
        "key": "lookaheadDays",
        "type": "integer",
        "label": "Agenda horizon (days)",
        "min": 1,
        "max": 30,
        "step": 1,
        "defaultValue": 7,
        "description": "How many days the panel and menu-bar preview load."
      },
      {
        "key": "maxTitleLength",
        "type": "integer",
        "label": "Maximum bar title length",
        "min": 12,
        "max": 120,
        "step": 2,
        "defaultValue": 42
      },
      {
        "key": "relativeLeadMinutes",
        "type": "integer",
        "label": "Relative countdown window (minutes)",
        "min": 0,
        "max": 120,
        "step": 5,
        "defaultValue": 10,
        "description": "Use relative labels for events starting within this window; use 0 for exact times."
      },
      {
        "key": "showTime",
        "type": "enum",
        "label": "Show event time on bar",
        "options": [
          "On",
          "Off"
        ],
        "defaultValue": "On"
      },
      {
        "key": "showTitle",
        "type": "enum",
        "label": "Show event title on bar",
        "options": [
          "On",
          "Off"
        ],
        "defaultValue": "On"
      },
      {
        "key": "showAllDay",
        "type": "enum",
        "label": "Include all-day events",
        "options": [
          "On",
          "Off"
        ],
        "defaultValue": "On"
      },
      {
        "key": "showEventsWithoutParticipants",
        "type": "enum",
        "label": "Include events without participants",
        "options": [
          "On",
          "Off"
        ],
        "defaultValue": "On"
      },
      {
        "key": "showEventsWithoutLocation",
        "type": "enum",
        "label": "Include events without location or meeting link",
        "options": [
          "On",
          "Off"
        ],
        "defaultValue": "On"
      }
    ]
  }
}

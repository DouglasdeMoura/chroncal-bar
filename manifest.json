{
  "schemaVersion": 1,
  "id": "douglasdemoura.chroncal-bar",
  "name": "Chroncal Bar",
  "version": "1.2.0",
  "author": "Douglas Moura",
  "license": "MIT",
  "description": "Notion Calendar-style menu-bar agenda for Chroncal: next meeting, one-click join, search, RSVP, and event editing.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Chroncal Bar",
    "description": "Chroncal agenda, search, quick actions, and event editing",
    "category": "Time",
    "allowMultiple": false,
    "defaultSection": "right",
    "schema": [
      {
        "key": "interval",
        "type": "integer",
        "label": "Refresh interval (seconds)",
        "min": 15,
        "max": 3600,
        "step": 15,
        "defaultValue": 60
      },
      {
        "key": "lookaheadDays",
        "type": "integer",
        "label": "Agenda horizon (days)",
        "min": 1,
        "max": 30,
        "step": 1,
        "defaultValue": 7,
        "description": "How many days the panel and menu-bar preview load."
      },
      {
        "key": "maxTitleLength",
        "type": "integer",
        "label": "Maximum bar title length",
        "min": 12,
        "max": 120,
        "step": 2,
        "defaultValue": 42
      },
      {
        "key": "barHorizonHours",
        "type": "integer",
        "label": "Bar horizon (hours)",
        "min": 0,
        "max": 168,
        "step": 1,
        "defaultValue": 0,
        "description": "Only show events on the bar that start within this many hours; 0 shows anything in the agenda horizon."
      },
      {
        "key": "relativeLeadMinutes",
        "type": "integer",
        "label": "Relative countdown window (minutes)",
        "min": 0,
        "max": 120,
        "step": 5,
        "defaultValue": 10,
        "description": "Use relative labels for events starting within this window; use 0 for exact times."
      },
      {
        "key": "showTime",
        "type": "enum",
        "label": "Show event time on bar",
        "options": [
          "On",
          "Off"
        ],
        "defaultValue": "On"
      },
      {
        "key": "showTitle",
        "type": "enum",
        "label": "Show event title on bar",
        "options": [
          "On",
          "Off"
        ],
        "defaultValue": "On"
      },
      {
        "key": "showAllDay",
        "type": "enum",
        "label": "Include all-day events",
        "options": [
          "On",
          "Off"
        ],
        "defaultValue": "On"
      },
      {
        "key": "showEventsWithoutParticipants",
        "type": "enum",
        "label": "Include events without participants",
        "options": [
          "On",
          "Off"
        ],
        "defaultValue": "On"
      },
      {
        "key": "showEventsWithoutLocation",
        "type": "enum",
        "label": "Include events without location or meeting link",
        "options": [
          "On",
          "Off"
        ],
        "defaultValue": "On"
      },
      {
        "key": "showDeclinedEvents",
        "type": "enum",
        "label": "Include declined events in the agenda",
        "options": [
          "On",
          "Off"
        ],
        "defaultValue": "On",
        "description": "Declined events appear dimmed in the agenda and never on the bar."
      },
      {
        "key": "showOpenInChroncal",
        "type": "enum",
        "label": "Show Open in Chroncal on event details",
        "options": [
          "On",
          "Off"
        ],
        "defaultValue": "Off",
        "description": "Shows a button on event details that launches the Chroncal TUI on this event."
      },
      {
        "key": "joinReminderMinutes",
        "type": "integer",
        "label": "Meeting alert lead (minutes)",
        "min": -1,
        "max": 60,
        "step": 1,
        "defaultValue": -1,
        "description": "Send a notification with a Join action this many minutes before timed events; -1 turns alerts off."
      }
    ]
  }
}
